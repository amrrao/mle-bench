# AIDE agent image built from repo root so aideml can live at root.
#
# Build from repo root (llms-for-mle-bench):
#   docker build -f Dockerfile.aide .

FROM mlebench-env

ARG SUBMISSION_DIR
ENV SUBMISSION_DIR=${SUBMISSION_DIR}
ARG LOGS_DIR
ENV LOGS_DIR=${LOGS_DIR}
ARG CODE_DIR
ENV CODE_DIR=${CODE_DIR}
ARG AGENT_DIR
ENV AGENT_DIR=${AGENT_DIR}

RUN pip install "httpx<0.28.0"
RUN mkdir ${LOGS_DIR} ${CODE_DIR} ${AGENT_DIR}

ARG CONDA_ENV_NAME=agent
ARG REQUIREMENTS=${AGENT_DIR}/requirements.txt

# Agent files from mle-bench/agents/aide (context = repo root)
COPY mle-bench/agents/aide/ ${AGENT_DIR}/
# Overwrite with root-level aideml so pip install uses this copy
COPY aideml ${AGENT_DIR}/aideml

RUN apt-get update && apt-get install ffmpeg libsm6 libxext6 -y

WORKDIR ${AGENT_DIR}
RUN conda run -n ${CONDA_ENV_NAME} pip install -r ${AGENT_DIR}/requirements.txt && \
    conda clean -afy

